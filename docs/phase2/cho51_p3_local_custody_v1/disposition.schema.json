{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P3 historical failure and current-domain disposition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "disposition_id",
    "created_utc",
    "author",
    "policy_sha256",
    "historical",
    "status",
    "current_boundary",
    "reason_codes",
    "limitations",
    "launch_authorized",
    "scientific_admission"
  ],
  "properties": {
    "schema": {
      "const": "cho51_p3_local_custody_disposition_v1"
    },
    "disposition_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$",
      "maxLength": 36
    },
    "author": {
      "const": "project_root"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "historical": {
      "$ref": "#/$defs/historical"
    },
    "status": {
      "enum": [
        "REFUSED",
        "UNRESOLVED",
        "ELIGIBLE_FOR_LOCAL_ADMISSION_REVIEW"
      ]
    },
    "current_boundary": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "host_identity_sha256",
            "boot_generation_sha256",
            "evidence",
            "independent_actual_review"
          ],
          "properties": {
            "kind": {
              "const": "verified_complete_os_restart"
            },
            "host_identity_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "boot_generation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "evidence": {
              "$ref": "#/$defs/artifact"
            },
            "independent_actual_review": {
              "$ref": "#/$defs/artifact"
            }
          }
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "HISTORICAL_INPUT_MISSING",
          "HISTORICAL_HASH_MISMATCH",
          "HISTORICAL_STATE_UPGRADE",
          "HOST_ASSOCIATION_UNESTABLISHED",
          "PROVIDER_COVERAGE_UNQUALIFIED",
          "RESTART_KIND_UNESTABLISHED",
          "CLOCK_ORDER_UNESTABLISHED",
          "PERSISTED_DOMAIN_UNRESOLVED",
          "RAW_OBSERVATION_INCOMPLETE",
          "SOURCE_OR_RUNTIME_UNPINNED",
          "ACTUAL_REVIEW_MISSING",
          "ACTUAL_REVIEW_REJECTED",
          "EVIDENCE_STALE",
          "EVIDENCE_CONTRADICTED",
          "LOCAL_STOP_PRESENT_OR_UNKNOWN"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "launch_authorized": {
      "const": false
    },
    "scientific_admission": {
      "const": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 384,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "actual_audit",
        "failed_review",
        "status",
        "custody_closed",
        "operation_released",
        "retry_allowed"
      ],
      "properties": {
        "disposition": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "sha256": {
                  "const": "1faf198894e0f210e5bb8692a8c0c4b35f10963a1e2c8c928d545eb808c335ec"
                }
              }
            }
          ]
        },
        "actual_audit": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "sha256": {
                  "const": "365153e07d2f925d36168f0218404ae37c18962d0bbabb0598a284ff6740b75d"
                }
              }
            }
          ]
        },
        "failed_review": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "sha256": {
                  "const": "df900ab63aaf0f4ef0febbe11c3db7fa23ff9a178f5d8f65f6233ff35948e098"
                }
              }
            }
          ]
        },
        "status": {
          "const": "FAILED_UNRELEASED_CONSUMED"
        },
        "custody_closed": {
          "const": false
        },
        "operation_released": {
          "const": false
        },
        "retry_allowed": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ELIGIBLE_FOR_LOCAL_ADMISSION_REVIEW"
          }
        }
      },
      "then": {
        "properties": {
          "current_boundary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "host_identity_sha256",
              "boot_generation_sha256",
              "evidence",
              "independent_actual_review"
            ],
            "properties": {
              "kind": {
                "const": "verified_complete_os_restart"
              },
              "host_identity_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "boot_generation_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "evidence": {
                "$ref": "#/$defs/artifact"
              },
              "independent_actual_review": {
                "$ref": "#/$defs/artifact"
              }
            }
          },
          "reason_codes": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "current_boundary": {
            "type": "null"
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
