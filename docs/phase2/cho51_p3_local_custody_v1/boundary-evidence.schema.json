{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P3 locally admitted current-boundary evidence packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capture_id",
    "created_utc",
    "boundary_kind",
    "historical",
    "policy_sha256",
    "collector_source",
    "collector_protocol",
    "collector_source_review",
    "runtime_pins",
    "observation_admission",
    "event_to_host_binding",
    "current_host_identity",
    "restart_evidence",
    "clock_consistency_evidence",
    "persisted_domain_assessment",
    "actual_tool_return",
    "raw_observations",
    "observed_start_utc",
    "observed_end_utc",
    "qpc_frequency",
    "qpc_start",
    "qpc_end",
    "launch_authorized",
    "scientific_admission"
  ],
  "properties": {
    "schema": {
      "const": "cho51_p3_local_boundary_evidence_v1"
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$",
      "maxLength": 36
    },
    "boundary_kind": {
      "const": "complete_os_restart"
    },
    "historical": {
      "$ref": "#/$defs/historical"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "collector_source": {
      "$ref": "#/$defs/artifact"
    },
    "collector_protocol": {
      "$ref": "#/$defs/artifact"
    },
    "collector_source_review": {
      "$ref": "#/$defs/artifact"
    },
    "runtime_pins": {
      "$ref": "#/$defs/artifact"
    },
    "observation_admission": {
      "$ref": "#/$defs/artifact"
    },
    "event_to_host_binding": {
      "$ref": "#/$defs/artifact"
    },
    "current_host_identity": {
      "$ref": "#/$defs/artifact"
    },
    "restart_evidence": {
      "$ref": "#/$defs/artifact"
    },
    "clock_consistency_evidence": {
      "$ref": "#/$defs/artifact"
    },
    "persisted_domain_assessment": {
      "$ref": "#/$defs/artifact"
    },
    "actual_tool_return": {
      "$ref": "#/$defs/artifact"
    },
    "raw_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "observed_start_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$",
      "maxLength": 36
    },
    "observed_end_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$",
      "maxLength": 36
    },
    "qpc_frequency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000
    },
    "qpc_start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "qpc_end": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "launch_authorized": {
      "const": false
    },
    "scientific_admission": {
      "const": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 384,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "actual_audit",
        "failed_review",
        "status",
        "custody_closed",
        "operation_released",
        "retry_allowed"
      ],
      "properties": {
        "disposition": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "sha256": {
                  "const": "1faf198894e0f210e5bb8692a8c0c4b35f10963a1e2c8c928d545eb808c335ec"
                }
              }
            }
          ]
        },
        "actual_audit": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "sha256": {
                  "const": "365153e07d2f925d36168f0218404ae37c18962d0bbabb0598a284ff6740b75d"
                }
              }
            }
          ]
        },
        "failed_review": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "sha256": {
                  "const": "df900ab63aaf0f4ef0febbe11c3db7fa23ff9a178f5d8f65f6233ff35948e098"
                }
              }
            }
          ]
        },
        "status": {
          "const": "FAILED_UNRELEASED_CONSUMED"
        },
        "custody_closed": {
          "const": false
        },
        "operation_released": {
          "const": false
        },
        "retry_allowed": {
          "const": false
        }
      }
    }
  }
}
