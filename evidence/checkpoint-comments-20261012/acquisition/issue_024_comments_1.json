[{"url":"https://api.github.com/repos/935963004/LaBraM/issues/comments/2095094269","html_url":"https://github.com/935963004/LaBraM/issues/24#issuecomment-2095094269","issue_url":"https://api.github.com/repos/935963004/LaBraM/issues/24","id":2095094269,"node_id":"IC_kwDOLF0fBs584Jn9","user":{"login":"935963004","id":38138106,"node_id":"MDQ6VXNlcjM4MTM4MTA2","avatar_url":"https://avatars.githubusercontent.com/u/38138106?v=4","gravatar_id":"","url":"https://api.github.com/users/935963004","html_url":"https://github.com/935963004","followers_url":"https://api.github.com/users/935963004/followers","following_url":"https://api.github.com/users/935963004/following{/other_user}","gists_url":"https://api.github.com/users/935963004/gists{/gist_id}","starred_url":"https://api.github.com/users/935963004/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/935963004/subscriptions","organizations_url":"https://api.github.com/users/935963004/orgs","repos_url":"https://api.github.com/users/935963004/repos","events_url":"https://api.github.com/users/935963004/events{/privacy}","received_events_url":"https://api.github.com/users/935963004/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2024-05-06T02:26:30Z","updated_at":"2024-05-06T02:26:30Z","body":"在预训练时的时间窗口是4或8的原因是，LaBraM的最大输入长度为256。根据不同通道数的数据集，同时为了最大化资源利用率，你需要保证输入长度不超过256的同时最接近256，这个是灵活可变的。比如对于只有20个通道的数据集，时间窗口就设置为12。而TUAB作为下游任务数据集，我们跟随这个数据集上通常的设置，一个样本的长度为10秒，并没有其他特别的深意。由于LaBraM支持可变长度的输入，因此对于下游任务的长度没有特殊要求。","author_association":"OWNER","pin":null,"reactions":{"url":"https://api.github.com/repos/935963004/LaBraM/issues/comments/2095094269/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/935963004/LaBraM/issues/comments/2164272118","html_url":"https://github.com/935963004/LaBraM/issues/24#issuecomment-2164272118","issue_url":"h