.github.com/users/jianghaisi/followers","following_url":"https://api.github.com/users/jianghaisi/following{/other_user}","gists_url":"https://api.github.com/users/jianghaisi/gists{/gist_id}","starred_url":"https://api.github.com/users/jianghaisi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jianghaisi/subscriptions","organizations_url":"https://api.github.com/users/jianghaisi/orgs","repos_url":"https://api.github.com/users/jianghaisi/repos","events_url":"https://api.github.com/users/jianghaisi/events{/privacy}","received_events_url":"https://api.github.com/users/jianghaisi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-27T07:28:22Z","updated_at":"2025-05-27T07:28:22Z","body":"> 我想对 LaBraM 在EEG数据上的编码向量进行分析（模型权重从labram-base.pth导入，之后就冻结，不需要作训练和微调）。\n> \n> 假设信号已完成0.1Hz-75Hz的带通滤波，50Hz的陷波滤波， 重采样至200Hz\n> \n> 输入: sig.shape :(64, 200_60_60) # 64通道，200Hz采样率，一小时时长的EEG信号\n> \n> 输出： LaBraM模型对该eeg的表征向量：V\n> \n> V.shape :(64, n, V_dim) 64：通道数 n：EEG信号根据窗口宽度（1秒？），被分割为n=3600段 模型对信号的编码向量维度（好像是32维）\n> \n> V = LaBraM( sig )\n\n您好，请问您实现了吗？我一直没有怎么看懂，你能不能提供一下您提取特征的代码，让我参考一下，感激不尽！","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/935963004/LaBraM/issues/comments/2911459715/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/935963004/LaBraM/issues/comments/2911487034","html_url":"https://github.com/935963004/LaBraM/issues/5#issuecomment-2911487034","issue_url":"https://api.github.com/repos/935963004/LaBraM/issues/5","id":2911487034,"node_id":"IC_kwDOLF0fBs6ticQ6","user":{"login":"jianghaisi","id":78548677,"node_id":"MDQ6VXNlcjc4NTQ4Njc3","avatar_url":"https://avatars.githubusercontent.com/u/78548677?v=4","gravatar_id":"","url":"https://api.github.com/users/jianghaisi","html_url":"https://github.com/jianghaisi","followers_url":"https://api.github.com/users/jianghaisi/followers","following_url":"https://api.github.com/users/jianghaisi/following{/other_user}","gists_url":"https://api.github.com/users/jianghaisi/gists{/gist_id}","starred_url":"https://api.github.com/users/jianghaisi/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jianghaisi/subscriptions","organizations_url":"https://api.github.com/users/jianghaisi/orgs","repos_url":"https://api.github.com/users/jianghaisi/repos","events_url":"https://api.github.com/users/jianghaisi/events{/privacy}","received_events_url":"https://api.github.com/users/jianghaisi/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-05-27T07:37:20Z","updated_at":"2025-05-27T07:37:20Z","body":"> 你可以通过run_class_finetunging.py的脚本，在load模型之后，将训练的部分代码更改来达到你的目的。你需要将输入的形状转化为sig.shape: (3600, 64, 1, 200)，即3600个样本（一小时），64通道，每个样本长度为1秒，200Hz采样率；模型的输出V.shape: (3600, 64, 200)，即每个1秒的channel的数据都被编码为200维的向量。\n\n请问如果我的数据是128HZ的，请问我该如何处理呢？","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/935963004/LaBraM/issues/comments/2911487034/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/935963004/LaBraM/issues/comments/3007526923","html_url":"https://github.com/935963004/LaBraM/issues/5#issuecomment-3007526923","issue_url":"https://api.github.com/repos/935963004/LaBraM/issues/5","id":3007526923,"node_id":"IC_kwDOLF0fBs6zQzgL","user":{"login":"zkailong","id":13463791,"node_id":"MDQ6VXNlcjEzNDYzNzkx","avatar_url":"https://avatars.githubusercontent.com/u/13463791?v=4","gravatar_id":"","url":"https://api.github.com/users/zkailong","html_url":"https://github.com/zkailong","followers_url":"https://api.github.com/users/zkailong/followers","following_url":"https://api.github.com/users/zkailong/following{/other_user}","gists_url":"https://api.github.com/users/zkailong/gists{/gist_id}","starred_url":"https://api.github.com/users/zkailong/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/zkailong/subscriptions","organizations_url":"https://api.github.com/users/zkailong/orgs","repos_url":"https://api.github.com/users/zkailong/repos","events_url":"https://api.github.com/users/zkailong/events{/privacy}","received_events_url":"https://api.github.com/users/zkailong/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2025-06-26T07:47:06Z","updated_at":"2025-06-26T07:53:25Z","body":"> > 你可以通过run_class_finetunging.py的脚本，在load模型之后，将训练的部分代码更改来达到你的目的。你需要将输入的形状转化为sig.shape: (3600, 64, 1, 200)，即3600个样本（一小时），64通道，每个样本长度为1秒，200Hz采样率；模型的输出V.shape: (3600, 64, 200)，即每个1秒的channel的数据都被编码为200维的向量。\n> \n> 请问如果我的数据是128HZ的，请问我该如何处理呢？\n\n我的理解：结合其他回答来看，如果你输入的数据通道数为ch，时长为t，采样率为f，那么你的输入的shape应该是 $[ch, t\\times f]$ ，同时`args.input_size`应该设置为 $t\\times f$。\n但实际上，运行的时候，input的shape是 $[batch size, ch, t\\times f]$ ，在`engine_for_finetuning.py`中的第65行：\n https://github.com/935963004/LaBraM/blob/5f5ec3e702199ef0f16ee0bbaa8c2997cb77b786/engine_for_finetuning.py#L65\n此时会把 $t\\times f$ 拆成 $A\\times T$ ，其中 $T$ 是200，所以如果你的采样率是128的话，这边可能会出问题，所以简单点的办法是直接重采样到200吧。","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/935963004/LaBraM/issues/comments/3007526923/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/935963004/LaBraM/issues/comments/3334024147","html_url":"https://github.com/935963004/LaBraM/issues/5#issuecomment-3334024147","issue_url":"https://api.github.com/repos/935963004/LaBraM/issues/5","id":3334024147,"node_id":"IC_kwDOLF0fBs7GuSvT","user":{"login":"RenxuLogan","id":173548964,"node_id":"U_kgDOClglpA","avatar_url":"https://avatars.githubusercontent.com/u/173548964?v=4","gravatar_id":"","url":"https://api.github.